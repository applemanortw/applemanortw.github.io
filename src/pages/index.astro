---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactButtons from '../components/ContactButtons.astro';
import { Image } from 'astro:assets';
import { site, allProducts, productsIn, productImage, url } from '../lib/site';

const featured = ['S01', 'S13', 'S12', 'S14', 'P01', 'G03']
  .map((id) => allProducts.find((p) => p.id === id)!)
  .filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: `${site.name} ${site.nameEn}`,
  url: Astro.site?.href,
  telephone: '+886-2-2711-5939',
  sameAs: [site.line],
};
---
<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">APPLE MANOR · {site.tagline}</p>
      <h1>回歸自然的<br />天然草本生活</h1>
      <p class="lead">{site.about.intro}</p>
      <div class="btn-row">
        <a class="btn" href={url('/soap/')}>瀏覽手工皂</a>
        <a class="btn ghost" href="#contact">聯絡我們</a>
      </div>
    </div>
  </section>

  <section class="wrap cats" aria-label="商品分類">
    {site.categories.map((c) => {
      const cover = allProducts.find((p) => p.slug === c.cover) ?? productsIn(c.slug)[0];
      return (
        <a class="cat" href={url(`/${c.slug}/`)}>
          <div class="cat-img">
            <Image src={productImage(cover)} alt="" widths={[400, 800]} sizes="(max-width: 960px) 50vw, 270px" format="webp" loading="eager" decoding="async" />
          </div>
          <div class="cat-body">
            <span class="n">{c.name}</span>
            <span class="c">{c.blurb}</span>
            <span class="count">{productsIn(c.slug).length} 項商品 →</span>
          </div>
        </a>
      );
    })}
  </section>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="wrap in">
      <div class="about-brand">
        <img src={url('/images/logo-full.webp')} alt="蘋果莊園 Apple Manor 品牌標誌：蘋果樹，Absolutely Natural · Comprehensive Care" width="400" height="400" loading="lazy" />
        <div>
          <p class="eyebrow">關於蘋果莊園</p>
          <h2 id="about-title">傳承漢方的純樸與自然</h2>
        </div>
      </div>
      <div class="cols">
        <div>
          <h3>{site.about.philosophyLabel}</h3>
          <p>{site.about.philosophy}</p>
        </div>
        <div>
          <h3>{site.about.promiseLabel}</h3>
          <p>{site.about.promise}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>精選商品</h2>
        <a href={url('/soap/')}>查看全部手工皂 →</a>
      </div>
      <div class="grid">
        {featured.map((p, i) => <ProductCard product={p} eager={i < 3} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 96px 0 72px; }
  .hero h1 { font-size: 48px; margin-bottom: 20px; }
  .hero .lead { max-width: 600px; color: var(--muted); margin-bottom: 32px; }
  .cats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; padding-bottom: 24px; }
  .cat { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; color: inherit; transition: border-color .15s, transform .15s, box-shadow .15s; }
  .cat:hover { border-color: var(--brand); transform: translateY(-2px); box-shadow: 0 12px 28px -18px rgba(0,0,0,.25); color: inherit; }
  .cat-img { aspect-ratio: 1 / 1; background: #efebe3; overflow: hidden; }
  .cat-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .cat:hover .cat-img img { transform: scale(1.04); }
  .cat-body { display: flex; flex-direction: column; padding: 16px 18px 18px; }
  .cat .n { font-family: var(--font-serif); font-size: 18px; font-weight: 600; margin-bottom: 2px; }
  .cat .c { color: var(--muted); font-size: 14px; }
  .cat .count { margin-top: 10px; color: var(--brand); font-size: 13px; font-weight: 500; }
  .about .in { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; }
  .about h2 { font-size: 30px; }
  .about-brand { display: flex; flex-direction: column; gap: 20px; }
  .about-brand img { width: 180px; height: auto; }
  .about .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .about h3 { font-size: 16px; color: var(--brand); margin-bottom: 8px; }
  .about .cols p { color: var(--muted); margin: 0; }
  @media (max-width: 960px) { .cats { grid-template-columns: 1fr 1fr; } .about .in { grid-template-columns: 1fr; gap: 24px; } }
  @media (max-width: 720px) {
    .hero { padding: 56px 0 44px; }
    .hero h1 { font-size: 32px; }
    .about h2 { font-size: 24px; }
    .about .cols { grid-template-columns: 1fr; gap: 20px; }
  }
  @media (max-width: 720px) { .cats { gap: 14px; } .cat-body { padding: 12px 14px 14px; } .cat .n { font-size: 16px; } .cat .c { font-size: 13px; } .cat .count { font-size: 12px; } }
  @media (prefers-reduced-motion: reduce) { .cat, .cat-img img { transition: none; } }
</style>
