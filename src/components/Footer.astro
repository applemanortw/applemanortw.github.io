---
import { site, url } from '../lib/site';
import ContactButtons from './ContactButtons.astro';
const year = new Date().getFullYear();
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap in">
    <div>
      <h2 id="contact-title">聯絡我們</h2>
      <p class="muted">歡迎來電或加入 LINE 官方帳號，詢問商品與訂購。</p>
      <ContactButtons phoneFirst />
      <ul class="contact-list">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.8.3 1.7.5 2.6.7a2 2 0 0 1 1.7 2z"/></svg><a href={site.phoneHref}>{site.phone}</a></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <a class="qr" href={site.line} target="_blank" rel="noopener" aria-label="掃描或點擊 QR code 加入蘋果莊園 LINE 官方帳號">
      <img src={url(site.lineQr)} alt="" width="160" height="160" loading="lazy" />
      <span>LINE 官方帳號</span>
    </a>
  </div>
</section>
<footer class="site-footer">
  <div class="wrap">
    <p>© {year} {site.name} {site.nameEn} · {site.tagline}</p>
  </div>
</footer>

<style>
  .contact { background: var(--surface); border-top: 1px solid var(--line); padding: 64px 0; }
  .in { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; }
  .contact h2 { font-size: 28px; margin-bottom: 10px; }
  .contact p { margin-bottom: 22px; }
  .contact-list { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .contact-list li { display: flex; align-items: center; gap: 10px; }
  .contact-list svg { width: 18px; height: 18px; color: var(--brand); flex: none; }
  .contact-list a { color: var(--ink); word-break: break-all; }
  .contact-list a:hover { color: var(--brand); }
  .qr { display: flex; flex-direction: column; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; }
  .qr img { width: 160px; height: 160px; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; padding: 8px; }
  .site-footer { padding: 28px 0; color: var(--muted); font-size: 13px; text-align: center; }
  .site-footer p { margin: 0; }
  @media (max-width: 720px) {
    .contact { padding: 44px 0; }
    .in { grid-template-columns: 1fr; gap: 28px; }
    .contact h2 { font-size: 24px; }
    .qr { align-items: flex-start; }
  }
</style>
