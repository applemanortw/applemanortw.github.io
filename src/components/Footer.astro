---
import { site, url } from '../lib/site';
import ContactButtons from './ContactButtons.astro';
const year = new Date().getFullYear();
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div>
      <h2 id="contact-title">聯絡我們</h2>
      <p class="muted">歡迎來電、加入 LINE 官方帳號或來信，詢問商品與訂購。</p>
      <ContactButtons phoneFirst />
      <ul class="contact-list">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>
</section>
<footer class="site-footer">
  <div class="wrap">
    <p>© {year} {site.name} {site.nameEn} · {site.tagline}</p>
  </div>
</footer>

<style>
  .contact { background: var(--surface); border-top: 1px solid var(--line); padding: 64px 0; }
  .contact h2 { font-size: 28px; margin-bottom: 10px; }
  .contact p { margin-bottom: 22px; }
  .contact-list { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .contact-list li { display: flex; align-items: center; gap: 10px; }
  .contact-list svg { width: 18px; height: 18px; color: var(--brand); flex: none; }
  .contact-list a { color: var(--ink); word-break: break-all; }
  .contact-list a:hover { color: var(--brand); }
  .site-footer { padding: 28px 0; color: var(--muted); font-size: 13px; text-align: center; }
  .site-footer p { margin: 0; }
  @media (max-width: 720px) {
    .contact { padding: 44px 0; }
      .contact h2 { font-size: 24px; }
  }
</style>
