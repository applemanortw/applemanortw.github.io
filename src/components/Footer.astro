---
import { site } from '../lib/site';
const year = new Date().getFullYear();
const icons = {
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.8.3 1.7.5 2.6.7a2 2 0 0 1 1.7 2z"/>',
  line: '<path d="M12 3C6.5 3 2 6.6 2 11c0 3.9 3.5 7.2 8.2 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.6 1.1-.5 5.9-3.5 8-6 1.5-1.6 2.1-3.2 2.1-4.9C22 6.6 17.5 3 12 3z" fill="currentColor" stroke="none"/><path d="M7.5 9.5v4M10.5 9.5v4M13.2 9.5v4l2.6-4v4M18 9.5h-2v4h2M16 11.5h1.8" stroke="#fff" stroke-width="1.3"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  facebook: '<path d="M14 8h2.5V4.5H14c-2.5 0-4 1.6-4 4V11H7.5v3.5H10V21h3.5v-6.5h2.6l.6-3.5h-3.2V9c0-.6.4-1 1.1-1z" fill="currentColor" stroke="none"/>',
};
const cards = [
  ...[
  { key: 'phone', label: '電話', value: site.phone, href: site.phoneHref, external: false },
  { key: 'line', label: 'LINE 官方帳號', value: '加入好友線上詢問', href: site.line, external: true },
  { key: 'mail', label: 'Email', value: site.email, href: `mailto:${site.email}`, external: false },
  { key: 'facebook', label: 'Facebook', value: '蘋果莊園粉絲專頁', href: site.facebook, external: true },
].filter((c) => c.href)];
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title">聯絡我們</h2>
    <p class="muted">歡迎透過以下任一方式詢問商品與訂購。</p>
    <ul class="cards">
      {cards.map((c) => (
        <li>
          <a class="ccard" href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>
            <span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[c.key]} /></span>
            <span class="label">{c.label}</span>
            <span class="value">{c.value}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<footer class="site-footer">
  <div class="wrap">
    <p>© {year} {site.name} {site.nameEn} · {site.tagline}</p>
  </div>
</footer>

<style>
  .contact { background: var(--surface); border-top: 1px solid var(--line); padding: 64px 0; }
  .contact h2 { font-size: 28px; margin-bottom: 8px; }
  .contact > .wrap > p { margin-bottom: 28px; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .ccard { display: flex; flex-direction: column; gap: 4px; height: 100%; padding: 22px 20px; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); color: var(--ink); transition: border-color .15s, transform .15s; }
  .ccard:hover { border-color: var(--brand); transform: translateY(-2px); color: var(--ink); }
  .icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--brand-tint); color: var(--brand); margin-bottom: 10px; }
  .icon svg { width: 22px; height: 22px; }
  .label { font-size: 13px; color: var(--muted); }
  .value { font-weight: 500; font-size: 15px; word-break: break-all; line-height: 1.5; }
  .site-footer { padding: 28px 0; color: var(--muted); font-size: 13px; text-align: center; }
  .site-footer p { margin: 0; }
  @media (max-width: 960px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .contact { padding: 44px 0; }
    .contact h2 { font-size: 24px; }
    .cards { gap: 12px; }
    .ccard { padding: 16px 14px; }
    .icon { width: 38px; height: 38px; margin-bottom: 8px; }
    .icon svg { width: 19px; height: 19px; }
    .value { font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { .ccard { transition: none; } }
</style>
